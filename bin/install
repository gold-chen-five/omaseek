#!/usr/bin/env bash
# Enable omaseek and give it a way in: SUPER + D and a bar icon.
# Omarchy never runs plugin scripts or edits your config, so this is the
# opt-in step. Safe to re-run; never overwrites a binding you already have.
#
#   ./bin/install              link and enable, bind SUPER + D, add a bar icon
#   ./bin/install --no-bind    skip the keybind
#
# Re-run it after a `git pull`: an already-loaded panel keeps its old QML until
# the shell restarts, so an upgrade restarts omarchy-shell.

set -euo pipefail

REPO=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
PLUGIN_ID=omaseek
PLUGINS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
BINDINGS="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua"
SHELL_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
MENU_EXT="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc"
GIT_DIR_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/$PLUGIN_ID.git"

BIND_KEY="SUPER + D"
BIND_LINE="o.bind(\"$BIND_KEY\", \"Search\", \"omarchy-shell shell toggle $PLUGIN_ID\")"
LEGACY_MENU_LINE="  \"$PLUGIN_ID\": {\"icon\":\"\",\"label\":\"Search\",\"action\":\"omarchy-shell shell toggle $PLUGIN_ID\",\"description\":\"Web search and AI, with vim keys\"},"

do_bind=1
for arg in "$@"; do
  case "$arg" in
    --no-bind) do_bind=0 ;;
    -h|--help) awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 1 ;;
  esac
done

say () { printf '  %s\n' "$1"; }

on_bar () {
  [[ -f $SHELL_CONFIG ]] && jq -e --arg id "$PLUGIN_ID" '
    [.bar.layout.left[]?, .bar.layout.center[]?, .bar.layout.right[]?]
    | any(if type == "object" then .id == $id else . == $id end)
  ' "$SHELL_CONFIG" >/dev/null 2>&1
}

in_plugin_list () {
  [[ -f $SHELL_CONFIG ]] && jq -e --arg id "$PLUGIN_ID" '
    [.plugins[]?]
    | any(if type == "object" then .id == $id else . == $id end)
  ' "$SHELL_CONFIG" >/dev/null 2>&1
}

echo "omaseek"

# ---- the plugin itself ------------------------------------------------------

# Loaded before this run means an upgrade, which needs a restart to show.
was_loaded=0
if on_bar || in_plugin_list; then was_loaded=1; fi

mkdir -p "$PLUGINS_DIR"
link="$PLUGINS_DIR/$PLUGIN_ID"

# A clone made in place has its .git directory inside the plugins directory,
# which Omarchy watches recursively with nothing excluded: every commit, and
# every `git status` an editor runs, rewrites .git/index and reloads the
# plugin, wiping the open panel. Move the repository out and leave the
# one-line pointer file git follows.
if [[ $REPO == "$link" && -d $REPO/.git ]]; then
  if [[ -e $GIT_DIR_HOME ]]; then
    echo "  $REPO/.git is a directory, and $GIT_DIR_HOME already exists — left alone." >&2
    echo "  Move one of them aside, then re-run this script." >&2
  else
    mkdir -p "$(dirname -- "$GIT_DIR_HOME")"
    git -C "$REPO" init --quiet --separate-git-dir="$GIT_DIR_HOME"
    say "moved the git repository to $GIT_DIR_HOME, out of the watched plugins directory"
  fi
fi

if [[ $REPO == "$link" ]]; then
  say "already in place: $REPO"
elif [[ -L $link && $(readlink -f "$link") == "$REPO" ]]; then
  say "already linked: $link"
elif [[ -e $link ]]; then
  echo "  $link already exists and is not this repo — remove it first:" >&2
  echo "    rm $link" >&2
  exit 1
else
  ln -s "$REPO" "$link"
  say "linked $link -> $REPO"
fi

omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true

# bar put waits for an in-progress plugin scan. Older installs recorded this
# overlay in plugins[]; remove that entry before retrying so it can move to the bar.
omarchy bar put "$PLUGIN_ID" --section center --index 0 >/dev/null
if ! on_bar && in_plugin_list; then
  omarchy plugin disable "$PLUGIN_ID" >/dev/null
  omarchy bar put "$PLUGIN_ID" --section center --index 0 >/dev/null
fi
if ! on_bar; then
  echo "  could not add $PLUGIN_ID to the bar; make sure omarchy-shell is running" >&2
  exit 1
fi
say "enabled and added the search icon to the middle of the bar"

# ---- the keybind ------------------------------------------------------------
#
# Left alone when SUPER + D is already bound to something else.

if (( do_bind )); then
  if [[ ! -f $BINDINGS ]]; then
    say "no $BINDINGS — add this yourself:"
    say "    $BIND_LINE"
  elif grep -qF "toggle $PLUGIN_ID" "$BINDINGS"; then
    say "keybind already there"
  elif grep -qE "^[^-]*o\.bind\(\"SUPER[[:space:]]*\+[[:space:]]*D\"" "$BINDINGS"; then
    say "SUPER + D is already bound to something else — left alone. To use it:"
    say "    $BIND_LINE"
  else
    cp "$BINDINGS" "$BINDINGS.omaseek-backup"
    printf '\n-- omaseek\n%s\n' "$BIND_LINE" >>"$BINDINGS"
    say "bound $BIND_KEY (backup: $BINDINGS.omaseek-backup)"
    hyprctl reload >/dev/null 2>&1 && say "reloaded hyprland" || say "run: hyprctl reload"
  fi
fi

# ---- old menu entry ---------------------------------------------------------

# Remove only the exact row written by the old installer, not a user-authored
# entry that happens to use the same id.
if [[ -f $MENU_EXT ]] && grep -qxF "$LEGACY_MENU_LINE" "$MENU_EXT"; then
  menu_backup="$MENU_EXT.omaseek-menu-backup"
  cp "$MENU_EXT" "$menu_backup"
  awk -v line="$LEGACY_MENU_LINE" '$0 != line' "$menu_backup" >"$MENU_EXT"
  say "removed the old Omarchy menu entry (backup: $menu_backup)"
fi

# ---- load the new version -------------------------------------------------

# rescanPlugins re-reads the plugin list but does not rebuild a panel that is
# already loaded (keepLoaded), so an upgrade would keep running the old code.
if (( was_loaded )); then
  if omarchy-restart-shell >/dev/null 2>&1; then
    say "restarted omarchy-shell so the new version loads"
  else
    say "run: omarchy-restart-shell   (the running panel still has the old version)"
  fi
fi

echo
say "open it with $BIND_KEY, or the search icon on the bar"
say "searching needs a SearXNG instance: ./bin/searxng-up"
