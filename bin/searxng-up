#!/usr/bin/env bash
# Create or start the SearXNG instance this panel searches through. Idempotent.
#
#   ./bin/searxng-up          create or start it, and wait until it answers;
#                             never set up, it first asks Podman or Docker
#   ./bin/searxng-up --choose ask Podman or Docker, then as --use with the answer
#   ./bin/searxng-up --stop   stop it, keeping the container
#   ./bin/searxng-up --down   stop and remove the container (config is kept)
#   ./bin/searxng-up --update offer the newest image by its digest, and switch on a yes
#   ./bin/searxng-up --purge  remove the container and its image (config is kept)
#   ./bin/searxng-up --use podman|docker
#                             run SearXNG with that engine from now on, removing
#                             omaseek's container and images from the other, then start
#   ./bin/searxng-up --engine print the engine in use: podman or docker
#   ./bin/searxng-up --present exit 0 when there may be a container or image to remove
#   ./bin/searxng-up --hint   print the commands that would remove them by hand
#
# Only what omaseek made is ever touched: the container named $NAME and
# labelled $LABEL, and images it pulled itself (recorded in $PULLED). A
# SearXNG the user runs — a container named `searxng`, the `:latest` image,
# an image that was already there — is never stopped, replaced or removed.
#
# Podman when it is installed: it runs rootless, so neither this script nor the
# image ever gets root. Docker otherwise, asking for sudo only for docker calls,
# and only outside the docker group. The engine a container was created with
# is remembered in $ENGINE_FILE; OMASEEK_ENGINE overrides it.
#
# The image is always named by its digest, never by a moving tag: what runs is
# the build reviewed with this plugin, or a newer one the reader agreed to in
# --update, which is remembered in $CHOSEN. SearXNG has no stable releases —
# every commit to master is one, published as a dated tag — so bumping PINNED
# means picking a dated tag whose CI passed and copying its digest from Docker
# Hub.

set -euo pipefail

NAME=omaseek-searxng
LABEL=omaseek=searxng
# The host port comes from searxng_url in the panel's config.json — the same key
# the backend reads — and 8888 when it is absent or unparsable. Another service
# may already hold 8888 (a proxy, say), so the port is the reader's to move.
# A searxng_url on another host is an instance the reader runs themselves: the
# container here is published on 127.0.0.1 only (not ::1), so it could never
# answer there, and REMOTE_HOST names that host so nothing is created or started for it.
# LOCAL_HOSTS in backend/omaseek/search/config.py is the same list.
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omaseek/config.json"
REMOTE_HOST=""
PORT=""
IFS=' ' read -r PORT REMOTE_HOST < <(python3 - "$CONFIG_FILE" <<'PY' 2>/dev/null || true
import json, sys, urllib.parse
try:
    url = json.load(open(sys.argv[1])).get("searxng_url")
    parsed = urllib.parse.urlparse(url.strip())
    host, port = parsed.hostname, parsed.port
except Exception:
    host = port = None
if host and host not in ("localhost", "127.0.0.1"):
    print("-", "".join(c for c in host if c.isprintable()) or "another host")
else:
    print(port or "-")
PY
) || true
[[ $PORT =~ ^[0-9]+$ ]] || PORT=8888
PINNED_TAG=2026.9.25-d8ae3abd5
PINNED_DIGEST=sha256:38ed750807fb00c26047e51896b50f83e7843d120d9e65f950770305f62c7111
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omaseek"
CHOSEN="$STATE_DIR/searxng-image"
ENGINE_FILE="$STATE_DIR/searxng-engine"
# "<engine> <image>" per line: images omaseek pulled, not ones already there.
PULLED="$STATE_DIR/searxng-pulled"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/searxng"
SETTINGS="$CONFIG_DIR/settings.yml"
URL="http://localhost:$PORT"
# The image's own user, which its entrypoint chowns the config to.
SEARXNG_UID=977

say()  { printf '\033[1m==>\033[0m %s\n' "$*" || true; }
warn() { printf '\033[33m warn:\033[0m %s\n' "$*" >&2 || true; }
die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# A yes from the reader, No unless they say otherwise; without a terminal to
# ask in, the answer is no.
confirm() {
  if [[ -t 0 ]] && command -v gum >/dev/null; then
    gum confirm --default=false "$1"          # Enter keeps what runs
  else
    local reply=""
    read -r -p "$1 [y/N] " reply || true
    [[ $reply == [yY]* ]]
  fi
}

# omaseek's state lives in a directory of its own, and no write there follows a
# symlink: the directory or a file in it being one is refused, and every file
# is written as a new file beside it and renamed over it, which replaces a link
# rather than writing through it. A link could point a write at anything.
refuse_links() {
  local path
  for path in "$STATE_DIR" "$CHOSEN" "$ENGINE_FILE" "$PULLED"; do
    [[ ! -L $path ]] || die "refusing to use $path: it is a symlink"
  done
}

state_dir() {
  refuse_links
  mkdir -p -m 700 -- "$STATE_DIR"
  [[ -d $STATE_DIR && -O $STATE_DIR ]] || die "refusing to use $STATE_DIR: not a directory of yours"
  chmod 700 -- "$STATE_DIR"                  # one an older omaseek made may be 755
}

# Replaces file $1 with the text $2.
state_write() {
  local tmp
  state_dir
  tmp=$(mktemp -- "$STATE_DIR/.write.XXXXXX") || die "could not write $1"
  if ! printf '%s' "$2" > "$tmp" || ! mv -fT -- "$tmp" "$1"; then
    rm -f -- "$tmp"
    die "could not write $1"
  fi
}

# File $1's text; nothing when it is absent, or a symlink, which is not read.
state_read() {
  [[ ! -L $1 ]] || { warn "ignoring $1: it is a symlink"; return 0; }
  [[ -f $1 ]] || return 0
  cat -- "$1"
}

usage="usage: $0 [--stop|--down|--update|--purge|--present|--hint|--engine|--choose|--use podman|docker]"

# "<dated tag> <digest>", as --update writes it and bin/search --newest-image prints it.
valid_choice() { [[ $1 =~ ^[0-9]{4}\.[0-9]{1,2}\.[0-9]{1,2}-[0-9a-f]{7,40}\ sha256:[0-9a-f]{64}$ ]]; }

TAG=$PINNED_TAG
DIGEST=$PINNED_DIGEST
chosen=$(state_read "$CHOSEN")
if [[ -n $chosen ]]; then
  if valid_choice "$chosen"; then
    read -r TAG DIGEST <<<"$chosen"
  else
    warn "ignoring $CHOSEN — not a '<tag> sha256:<digest>' line; using $PINNED_TAG"
  fi
fi

# OMASEEK_ENGINE, then the engine the container was created with, then Podman
# when it is installed, Docker when only that is, and Podman — offered for
# install — when neither is.
recorded=$(state_read "$ENGINE_FILE")
case "${OMASEEK_ENGINE:-}" in
  podman|docker) ENGINE=$OMASEEK_ENGINE ;;
  "")
    case "$recorded" in
      podman|docker) ENGINE=$recorded ;;
      *)
        if command -v podman >/dev/null; then ENGINE=podman
        elif command -v docker >/dev/null; then ENGINE=docker
        else ENGINE=podman; fi
        ;;
    esac
    ;;
  *) die "OMASEEK_ENGINE must be podman or docker, not '$OMASEEK_ENGINE'" ;;
esac

# Podman is given the fully qualified name: a short one can stop to ask which
# registry is meant, and there may be no terminal to ask in.
repo_of() { [[ $1 == podman ]] && echo docker.io/searxng/searxng || echo searxng/searxng; }

# The images omaseek pulled into engine $1.
pulled_of() {
  state_read "$PULLED" | awk -v engine="$1" '$1 == engine { print $2 }'
}

# Whether omaseek ever put anything in engine $1. Docker is asked only then, so
# a Podman user is never asked for sudo just to look.
used_engine() { [[ $recorded == "$1" || -n $(pulled_of "$1") ]]; }

REPO=$(repo_of "$ENGINE")
IMAGE=$REPO@$DIGEST

MODE=${1:-start}
USE=""
case "$MODE" in
  start|--stop|--down|--update|--purge|--present|--hint|--engine|--choose) (( $# <= 1 )) || die "$usage" ;;
  --use)
    (( $# == 2 )) || die "$usage"
    USE=$2
    [[ $USE == podman || $USE == docker ]] || die "$usage"
    ;;
  *) die "$usage" ;;
esac

# Creating, starting or updating a container serves only a searxng_url on this
# machine. Stopping and removing one still work, so a container made before
# searxng_url moved elsewhere can be cleaned up.
if [[ -n $REMOTE_HOST ]]; then
  case "$MODE" in
    start|--update|--use|--choose)
      die "searxng_url in $CONFIG_FILE points to $REMOTE_HOST, a SearXNG omaseek
       does not manage, so there is nothing to set up here. To have omaseek run
       one on this machine, remove searxng_url or point it at localhost."
      ;;
  esac
fi

# Every mode past here may write state: a symlinked state path stops it before
# anything is done, not halfway through.
case "$MODE" in
  --engine|--hint|--present) ;;
  *) refuse_links ;;
esac

if [[ $MODE == --engine ]]; then
  echo "$ENGINE"
  exit 0
fi

# The removal commands, one line per engine omaseek used, for bin/uninstall and
# bin/on-remove to print when SearXNG is kept.
if [[ $MODE == --hint ]]; then
  for engine in podman docker; do
    used_engine "$engine" || continue
    line="$engine rm -f $NAME"
    images=$(pulled_of "$engine" | tr '\n' ' ')
    [[ -z ${images// } ]] || line+=" && $engine image rm ${images% }"
    echo "$line"
  done
  exit 0
fi

# Whether removing omaseek should ask about SearXNG, under either engine.
# Answered without sudo and without starting a daemon, so it runs unattended;
# when docker cannot be asked but omaseek used it, the container may well
# exist, so the question is still worth putting.
if [[ $MODE == --present ]]; then
  present_in() {
    local engine=$1 image
    command -v "$engine" >/dev/null || return 1
    if ! "$engine" info >/dev/null 2>&1; then
      [[ $engine == docker ]] && used_engine docker
      return
    fi
    "$engine" ps -a --filter "label=$LABEL" --format '{{.Names}}' 2>/dev/null | grep -qx "$NAME" && return 0
    while read -r image; do
      "$engine" image inspect "$image" >/dev/null 2>&1 && return 0
    done < <(pulled_of "$engine")
    return 1
  }
  present_in podman || present_in docker
  exit
fi

# The engine the reader chose, installed on a yes. The package is one of two
# fixed names, never taken from input; it comes from the official repositories,
# in this terminal, with the reader's own password; --needed leaves an
# installed one alone. No, or no terminal to ask in, changes nothing.
offer_install() {
  local package=$1
  [[ $package == podman || $package == docker ]] || die "not an engine omaseek installs: $package"
  confirm "$package is not installed. Install it now? (sudo pacman -S --needed $package)" ||
    die "$package is not installed, and nothing was changed — install it with:  sudo pacman -S $package"
  sudo pacman -S --needed "$package" || die "installing $package failed — nothing else was changed"
  hash -r
  command -v "$package" >/dev/null || die "$package was installed but is not on PATH — open a new terminal and run this again"
}

# Sets CHOICE to podman or docker, as the reader picks it in this terminal:
# Podman first, as it runs SearXNG without root, unless SearXNG already runs
# with Docker. Without gum, a numbered list; no answer takes the first.
choose_engine() {
  local first=podman second=docker pick="" name label labels=()
  [[ $recorded == docker ]] && { first=docker second=podman; }
  for name in "$first" "$second"; do
    label=$name
    [[ $name == podman ]] && label+=" — runs SearXNG without root (recommended)"
    [[ $name == docker ]] && label+=" — may ask for your password"
    command -v "$name" >/dev/null || label+=" · not installed: offered for install"
    labels+=("$label")
  done
  if [[ -t 0 ]] && command -v gum >/dev/null; then
    pick=$(gum choose --header "Run SearXNG with:" "${labels[@]}") ||
      die "nothing was chosen, and nothing was changed"
  else
    say "Run SearXNG with:"
    printf '  1) %s\n  2) %s\n' "${labels[@]}"
    read -r -p "1 or 2 [1]: " pick || true
    case "$pick" in
      ""|1) pick=${labels[0]} ;;
      2) pick=${labels[1]} ;;
      *) die "'$pick' is not 1 or 2 — nothing was changed" ;;
    esac
  fi
  CHOICE=${pick%% *}
  [[ $CHOICE == podman || $CHOICE == docker ]] || die "nothing was chosen, and nothing was changed"
}

# Sets docker=(...) to the command that reaches $1: podman as it is, docker
# directly or through sudo. An engine not installed is offered for install.
connect() {
  if [[ $1 == podman ]]; then
    command -v podman >/dev/null || offer_install podman
    docker=(podman)
    podman info >/dev/null 2>&1 || die "podman cannot run containers as you — see: podman info"
    return
  fi
  command -v docker >/dev/null || offer_install docker
  docker=(docker)
  if ! docker info >/dev/null 2>&1; then
    if ! systemctl is-active --quiet docker; then
      say "starting the docker daemon — sudo needed"
      sudo systemctl enable --now docker
    fi
    if ! docker info >/dev/null 2>&1; then
      say "using sudo for docker (you are not in the 'docker' group)"
      docker=(sudo docker)
      "${docker[@]}" info >/dev/null 2>&1 || die "cannot talk to the docker daemon"
    fi
  fi
}

# omaseek's container: its name and its label both. Another container by that
# name, which omaseek did not create, is not it.
ours() {
  local names
  if ! names=$("${docker[@]}" ps "$@" --filter "label=$LABEL" --format '{{.Names}}'); then
    die "could not list $ENGINE containers"
  fi
  grep -qx "$NAME" <<<"$names"
}
exists() { ours -a; }
running() { ours; }

have_image() { "${docker[@]}" image inspect "$1" >/dev/null 2>&1; }

# Recorded only when it was not there before omaseek pulled it ($2 = false):
# an image the user already had stays theirs.
note_pulled() {
  [[ $2 == false ]] || return 0
  local pulled
  pulled=$(state_read "$PULLED")
  grep -qxF "$ENGINE $1" <<<"$pulled" || state_write "$PULLED" "${pulled:+$pulled
}$ENGINE $1
"
}

forget_pulled() {
  local pulled rest
  pulled=$(state_read "$PULLED")
  [[ -n $pulled ]] || return 0
  rest=$(awk -v line="$ENGINE $1" '$0 != line' <<<"$pulled")
  state_write "$PULLED" "${rest:+$rest
}"
}

# omaseek's container, and the images omaseek pulled, from the engine in
# docker=(). An image goes only when nothing else still uses it, which the
# engine itself refuses on our behalf.
remove_all() {
  local image
  if exists; then
    "${docker[@]}" rm -f "$NAME" >/dev/null
    say "removed the $NAME container"
  else
    say "no $NAME container to remove"
  fi
  while read -r image; do
    if ! have_image "$image"; then
      forget_pulled "$image"
    elif "${docker[@]}" image rm "$image" >/dev/null; then
      say "removed the $image image"
      forget_pulled "$image"
    else
      warn "kept the $image image — another container still uses it"
    fi
  done < <(pulled_of "$ENGINE")
}

# --choose, or the first setup from a terminal: the reader picks the engine.
# OMASEEK_ENGINE, or an engine already recorded, answers for a plain start.
if [[ $MODE == --choose ]] ||
   [[ $MODE == start && -z ${OMASEEK_ENGINE:-} && $recorded != podman && $recorded != docker && -t 0 ]]; then
  choose_engine
  USE=$CHOICE
  MODE=start
fi

if [[ -n $USE ]]; then
  other=docker
  [[ $USE == docker ]] && other=podman
  # Only an engine omaseek used, that is there and running, can hold its
  # container; a stopped docker daemon is not started just to be emptied.
  if used_engine "$other" && command -v "$other" >/dev/null &&
     { [[ $other == podman ]] || systemctl is-active --quiet docker; }; then
    # Nothing is removed without a yes, even after picking the engine.
    confirm "Move SearXNG from $other to $USE? omaseek's container and the images it pulled under $other are removed; $CONFIG_DIR is kept." ||
      die "nothing was changed — SearXNG stays with $other"
    ENGINE=$other
    connect "$other"
    say "removing SearXNG from $other"
    remove_all
  fi
  ENGINE=$USE REPO=$(repo_of "$USE") IMAGE=$(repo_of "$USE")@$DIGEST
  MODE=start
fi

# What bin/uninstall runs when asked to take SearXNG too, from whichever
# engine omaseek used: after --use, that may not be the one in use now.
if [[ $MODE == --purge ]]; then
  rm -f "$CHOSEN" "$ENGINE_FILE"
  for ENGINE in podman docker; do
    command -v "$ENGINE" >/dev/null || continue
    if [[ $ENGINE == podman ]]; then
      podman info >/dev/null 2>&1 || continue
    else
      used_engine docker || continue
      systemctl is-active --quiet docker || continue
    fi
    connect "$ENGINE"
    say "SearXNG under $ENGINE:"
    remove_all
  done
  say "$CONFIG_DIR was left alone — delete it yourself if you no longer want it"
  exit 0
fi

connect "$ENGINE"
# Recorded only once it is reachable: a no to installing it leaves the old one.
if [[ -n $USE ]]; then
  state_write "$ENGINE_FILE" "$USE
"
  say "omaseek now runs SearXNG with $USE"
fi

container_args=(
  --name "$NAME"
  --label "$LABEL"
  -p "127.0.0.1:$PORT:8080"
  -v "$CONFIG_DIR:/etc/searxng"
)
if [[ $ENGINE == podman ]]; then
  # You are the image's searxng user inside, so the config stays yours to
  # edit and the entrypoint has nothing to chown. `always`, because
  # podman-restart.service, which starts containers at login, takes no other.
  container_args+=(--userns "keep-id:uid=$SEARXNG_UID,gid=$SEARXNG_UID" --restart always)
else
  container_args+=(--restart unless-stopped)
fi

# Once a container exists, its engine is the one to come back to.
created() {
  state_write "$ENGINE_FILE" "$ENGINE
"
  [[ $ENGINE == podman ]] || return 0
  # Podman has no daemon to bring the container back after a reboot; this
  # user unit does, at login.
  systemctl --user is-enabled --quiet podman-restart.service 2>/dev/null ||
    systemctl --user enable podman-restart.service >/dev/null 2>&1 ||
    warn "could not enable podman-restart.service — SearXNG will not start by itself after a reboot"
}

create_container() {
  "${docker[@]}" create "${container_args[@]}" "$1" >/dev/null && created
}

run_container() {
  "${docker[@]}" run -d "${container_args[@]}" "$1" >/dev/null && created
}

# The host port $NAME publishes SearXNG on, from how it was created, so a
# stopped container answers too. Empty when it cannot be read.
published_port() {
  "${docker[@]}" inspect \
    --format '{{range (index .HostConfig.PortBindings "8080/tcp")}}{{.HostPort}}{{end}}' \
    "$NAME" 2>/dev/null || true
}

# container_args, publishing on port $1 instead.
publish_on() {
  local i
  for i in "${!container_args[@]}"; do
    [[ ${container_args[$i]} != 127.0.0.1:*:8080 ]] || container_args[$i]="127.0.0.1:$1:8080"
  done
}

port_taken() {
  python3 - port-check "$PORT" <<'PROBE' 2>/dev/null
import socket, sys
try:
    socket.create_connection(("127.0.0.1", int(sys.argv[2])), timeout=1).close()
except OSError:
    sys.exit(1)
PROBE
}

wait_until_ready() {
  local deadline=$(( $(date +%s) + 60 ))
  say "waiting for the JSON API on $URL"
  while true; do
    if python3 - "$URL" <<'PROBE' 2>/dev/null; then
import json, sys, urllib.parse, urllib.request
url = sys.argv[1] + "/search?" + urllib.parse.urlencode({"q": "ping", "format": "json"})
with urllib.request.urlopen(url, timeout=3) as response:
    sys.exit(0 if isinstance(json.load(response).get("results"), list) else 1)
PROBE
      say "ready — searching through $URL"
      return 0
    fi
    (( $(date +%s) >= deadline )) && return 1
    sleep 1
  done
}

restore_running() {
  local image=$1 reason=$2
  trap '' HUP INT TERM
  warn "$reason — restoring the previous image"
  ! (exists) || "${docker[@]}" rm -f "$NAME" >/dev/null 2>&1 || true
  if run_container "$image" && wait_until_ready; then
    die "$reason; restored the previous image"
  fi
  die "$reason, and the previous image could not be restored"
}

restore_stopped() {
  local image=$1 reason=$2
  trap '' HUP INT TERM
  warn "$reason — restoring the previous stopped container"
  ! (exists) || "${docker[@]}" rm -f "$NAME" >/dev/null 2>&1 || true
  create_container "$image" || die "$reason, and the previous container could not be restored"
  die "$reason; restored the previous stopped container"
}

restore_interrupted() {
  local image=$1 was_running=$2 status=$3
  # A second Ctrl+C must not interrupt the short window where the old image is
  # being put back under the container's well-known name.
  trap '' HUP INT TERM
  warn "update interrupted — restoring the previous container"
  ! (exists) || "${docker[@]}" rm -f "$NAME" >/dev/null 2>&1 || true
  if [[ $was_running == true ]]; then
    run_container "$image" || die "update interrupted, and the previous container could not be restored"
  else
    create_container "$image" || die "update interrupted, and the previous stopped container could not be restored"
  fi
  exit "$status"
}


# Remembered only once the new image runs, or is ready to: a failed switch
# leaves start, purge and the next update on the image that was restored.
remember_choice() {
  state_write "$CHOSEN" "$1 $2
"
}

update_image() {
  local previous_image="" previous_ref="" latest_image="" was_running=false newest new_tag new_digest new_image
  if exists; then
    previous_image=$("${docker[@]}" inspect --format '{{.Image}}' "$NAME")
    # What the container was created from — an older omaseek's `:latest`, say
    # — which is not necessarily the image start would use now.
    previous_ref=$("${docker[@]}" inspect --format '{{.Config.Image}}' "$NAME")
    running && was_running=true
  fi

  # The digest behind `latest` right now, so what is shown is what is pulled.
  say "looking up the newest SearXNG image on Docker Hub"
  newest=$("$(dirname -- "${BASH_SOURCE[0]}")/search" --newest-image) ||
    die "could not look up the newest image on Docker Hub — nothing was changed"
  valid_choice "$newest" || die "Docker Hub answered with an unexpected image: $newest"
  read -r new_tag new_digest <<<"$newest"
  new_image=$REPO@$new_digest

  if [[ -z $previous_ref ]]; then
    say "current: no container yet — start would use $TAG"
  elif [[ $previous_ref == "$IMAGE" ]]; then
    say "current: $TAG  ($DIGEST)"
  else
    say "current: $previous_ref"
  fi
  if [[ $previous_ref == "$new_image" || ( -z $previous_ref && $new_digest == "$DIGEST" ) ]]; then
    say "newest:  the same image"
  else
    say "newest:  $new_tag  ($new_digest)"
    confirm "Switch SearXNG to $new_tag?" || { say "kept the current image — nothing was changed"; return; }
  fi

  # Pull before touching a working container. A registry or network failure
  # therefore leaves the search service exactly as it was. Pulled by digest,
  # Docker refuses any image that does not match it.
  say "pulling $new_tag"
  local had=false
  have_image "$new_image" && had=true
  "${docker[@]}" pull "$new_image"
  note_pulled "$new_image" "$had"
  latest_image=$("${docker[@]}" image inspect --format '{{.Id}}' "$new_image")

  if [[ -z $previous_image ]]; then
    remember_choice "$new_tag" "$new_digest"
    say "$new_tag is ready — start SearXNG from Settings"
    return
  fi
  # The same bytes under another name — an older omaseek's `:latest` — are
  # still recreated, so the container is named by digest and the next update
  # does not ask again.
  if [[ $previous_image == "$latest_image" && $previous_ref == "$new_image" ]]; then
    remember_choice "$new_tag" "$new_digest"
    say "SearXNG is already up to date"
    return
  fi

  say "installing the newer SearXNG image"
  trap 'restore_interrupted "$previous_image" "$was_running" 129' HUP
  trap 'restore_interrupted "$previous_image" "$was_running" 130' INT
  trap 'restore_interrupted "$previous_image" "$was_running" 143' TERM
  "${docker[@]}" rm -f "$NAME" >/dev/null
  if [[ $was_running == true ]]; then
    run_container "$new_image" || restore_running "$previous_image" "could not create the updated container"
    wait_until_ready || restore_running "$previous_image" "the updated container did not become ready"
    trap - HUP INT TERM
    remember_choice "$new_tag" "$new_digest"
    say "updated SearXNG to $new_tag and restarted it"
  else
    create_container "$new_image" || restore_stopped "$previous_image" "could not create the updated container"
    trap - HUP INT TERM
    remember_choice "$new_tag" "$new_digest"
    say "updated SearXNG to $new_tag; it remains stopped"
  fi
}

# Puts $NAME back as it was before move_port: the same image, on its old port,
# running or stopped as it was.
restore_port() {
  local image=$1 old_port=$2 was_running=$3 reason=$4
  trap '' HUP INT TERM
  warn "$reason — putting $NAME back on port $old_port"
  ! (exists) || "${docker[@]}" rm -f "$NAME" >/dev/null 2>&1 || true
  publish_on "$old_port"
  if [[ $was_running == true ]]; then
    run_container "$image" && die "$reason; $NAME is back on port $old_port"
  else
    create_container "$image" && die "$reason; $NAME is back on port $old_port, stopped"
  fi
  die "$reason, and $NAME could not be put back on port $old_port"
}

# A container keeps the port it was created with, so searxng_url moved to
# another port means recreating it there: the same image, so nothing is pulled
# and the digest it runs stays the one agreed to. What holds the new port is
# left alone, as on a first start, and a container that does not come up on it
# is put back on the old one.
move_port() {
  local old_port=$1 image ref was_running=false
  running && was_running=true
  if port_taken; then
    die "searxng_url moved SearXNG to port $PORT, but something already listens on
       127.0.0.1:$PORT, and omaseek leaves what it did not create alone. $NAME
       was left on port $old_port."
  fi
  # By digest when it was created by one: immutable, and already here. An
  # older omaseek's container made from a tag is recreated from its image ID,
  # which names the same bytes and can never be pulled.
  ref=$("${docker[@]}" inspect --format '{{.Config.Image}}' "$NAME")
  if [[ $ref == *@sha256:* ]]; then
    image=$ref
  else
    image=$("${docker[@]}" inspect --format '{{.Image}}' "$NAME")
  fi

  say "moving $NAME from port $old_port to $PORT"
  trap 'restore_port "$image" "$old_port" "$was_running" "interrupted"' HUP INT TERM
  "${docker[@]}" rm -f "$NAME" >/dev/null
  publish_on "$PORT"
  run_container "$image" ||
    restore_port "$image" "$old_port" "$was_running" "could not create $NAME on port $PORT"
  wait_until_ready ||
    restore_port "$image" "$old_port" "$was_running" "$NAME did not answer on port $PORT"
  trap - HUP INT TERM
}

if [[ $MODE == --stop ]]; then
  running || { say "$NAME is not running"; exit 0; }
  "${docker[@]}" stop "$NAME" >/dev/null
  say "stopped $NAME — run ./bin/searxng-up to start it again"
  exit 0
fi

if [[ $MODE == --down ]]; then
  exists || { say "no $NAME container to remove"; exit 0; }
  "${docker[@]}" rm -f "$NAME" >/dev/null
  say "removed the $NAME container — $CONFIG_DIR was left alone"
  exit 0
fi

if [[ $MODE == --update ]]; then
  update_image
  exit 0
fi

# SearXNG serves HTML only until told otherwise, and its limiter would block
# the very plugin it is here to serve. Both are settled once, here.
# A dangling symlink is not a missing file: writing it would create the file
# it points at. And the write is exclusive (noclobber), so nothing that
# appears there meanwhile is written through either.
if [[ -L $SETTINGS && ! -e $SETTINGS ]]; then
  die "refusing to write $SETTINGS: it is a symlink to nothing"
fi
if [[ ! -e $SETTINGS ]]; then
  say "writing $SETTINGS"
  mkdir -p "$CONFIG_DIR"
  secret=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
  (set -C; cat > "$SETTINGS") <<YAML
# Settings for the omaseek panel's SearXNG instance.
# Minimal on purpose: anything not named here comes from SearXNG's defaults.
use_default_settings: true

server:
  secret_key: "$secret"
  # The limiter exists to stop strangers hammering a public instance. This one
  # listens on localhost only and is queried by a local plugin — the one client
  # it would end up blocking.
  limiter: false
  image_proxy: true

search:
  # SearXNG ships with html alone; the panel speaks JSON.
  formats:
    - html
    - json

outgoing:
  # SearXNG waits on the upstream engines it queries, so the slowest one that
  # still answers sets the pace. Trimming the ceiling from the 3s default cuts
  # the tail without losing engines that were ever going to reply in time.
  request_timeout: 2.0
  max_request_timeout: 4.0
  pool_connections: 100
  pool_maxsize: 20
  enable_http2: true
YAML
else
  # The image chowns this file to its own user on first run, so it is usually
  # no longer yours to edit — hence advice rather than an edit.
  grep -q '^\s*-\s*json\s*$' "$SETTINGS" ||
    warn "$SETTINGS does not enable the json format — the panel will get an HTTP 403"
  grep -q '^outgoing:' "$SETTINGS" ||
    warn "$SETTINGS has no 'outgoing:' block — searches wait the default 3s on
       slow engines. See the SearXNG section of the README to trim that."
fi

if exists; then
  old_port=$(published_port)
  # Anything but one plain port — unreadable, or bound twice — is left as it is.
  if [[ $old_port =~ ^[0-9]+$ && $old_port != "$PORT" ]]; then
    move_port "$old_port"
    exit 0  # move_port waited for it to answer on the new port
  fi
fi

if running; then
  say "$NAME is already running"
elif exists; then
  say "starting the existing $NAME container"
  "${docker[@]}" start "$NAME" >/dev/null
else
  # Whatever holds the port — the user's own SearXNG, or the `searxng`
  # container an earlier omaseek made — is not ours to stop, so say so.
  if port_taken; then
    die "something already listens on 127.0.0.1:$PORT, and omaseek leaves what it did not
       create alone. If it is SearXNG from an earlier omaseek (a container named
       'searxng'), remove it yourself, then run this again:
         podman rm -f searxng        or        sudo docker rm -f searxng"
  fi
  say "creating the $NAME container from $TAG with $ENGINE (first run pulls ~200MB)"
  had=false
  have_image "$IMAGE" && had=true
  run_container "$IMAGE"
  note_pulled "$IMAGE" "$had"
fi

# Bound to 127.0.0.1 above, so the instance is not reachable from the network.
wait_until_ready || die "no JSON answer after 60s. Check: ${docker[*]} logs $NAME"
