#!/usr/bin/env bash
# Tests for the QML field, draft launcher, and src/lib/*.mjs.

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
QT_QPA_PLATFORM=offscreen /usr/lib/qt6/bin/qmltestrunner \
  -input test/qml \
  -import test/qml/imports
python3 test/agent-draft.test.py
python3 test/searxng-up.test.py
python3 test/search.test.py
python3 test/install.test.py
python3 test/ask.test.py
exec node --test test/*.test.mjs
