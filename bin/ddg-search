#!/usr/bin/env python3
"""DuckDuckGo HTML search -> JSON on stdout.

Deliberately stdlib-only so the plugin has no venv and no dependencies.
Kept out of QML so the fragile part (HTML parsing) is testable on its own:

    ./bin/ddg-search "python asyncio" | jq

Output is always a single JSON object:
    {"ok": true,  "results": [...], "next": {...}|null}
    {"ok": false, "error": "network"|"blocked"|"http"|"usage", "message": "..."}

The ok/false cases are distinguished on purpose: a blocked request and a
query with genuinely zero hits look identical to a naive parser, and the
panel must not tell the user "No results" when it was actually rebuffed.

Pagination: DuckDuckGo ignores a bare offset. The next page is only served
if the whole hidden form from the previous response is echoed back — vqd,
kl and nextParams included — so `next` carries that form verbatim and comes
back in as `--next '<json>'`.
"""

import http.cookiejar
import html
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

ENDPOINT = "https://html.duckduckgo.com/html/"
ICON_ENDPOINT = "https://external-content.duckduckgo.com/ip3/"

# Every query is a fresh process, so without this each search would arrive as a
# brand-new cookieless client — which is what DuckDuckGo's bot protection looks
# for. Persisting the jar makes a series of searches read as one session.
COOKIE_PATH = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "jonas.search", "cookies.txt",
)
TIMEOUT = 12
MAX_RESULTS = 25

# A plain urllib UA gets a challenge page; a browser UA gets results.
UA = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
)

RESULT_SPLIT = '<div class="result results_links results_links_deep web-result'
LINK_RE = re.compile(
    r'<a[^>]*class="result__a"[^>]*href="([^"]+)"[^>]*>(.*?)</a>', re.S
)
SNIPPET_RE = re.compile(r'class="result__snippet"[^>]*>(.*?)</a>', re.S)
TAG_RE = re.compile(r"<[^>]+>")
FORM_RE = re.compile(r"<form[^>]*>.*?</form>", re.S)
INPUT_RE = re.compile(r'<input[^>]*name="([^"]+)"[^>]*value="([^"]*)"')


def emit(obj):
    json.dump(obj, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def fail(error, message):
    emit({"ok": False, "error": error, "message": message})
    sys.exit(0)  # A handled failure is still a well-formed answer.


def clean(fragment):
    """HTML fragment -> plain text."""
    return html.unescape(TAG_RE.sub("", fragment)).strip()


def unwrap(href):
    """DDG wraps some links as //duckduckgo.com/l/?uddg=<encoded>."""
    if href.startswith("//"):
        href = "https:" + href
    try:
        query = urllib.parse.parse_qs(urllib.parse.urlparse(href).query)
    except ValueError:
        return href
    target = query.get("uddg")
    return urllib.parse.unquote(target[0]) if target else href


def opener():
    jar = http.cookiejar.MozillaCookieJar(COOKIE_PATH)
    try:
        jar.load(ignore_discard=True, ignore_expires=True)
    except (OSError, http.cookiejar.LoadError):
        pass  # first run, or an unreadable jar — start fresh
    return urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar)), jar


def save_cookies(jar):
    try:
        os.makedirs(os.path.dirname(COOKIE_PATH), exist_ok=True)
        jar.save(ignore_discard=True, ignore_expires=True)
    except OSError:
        pass  # a missing cache dir must not fail a search


def fetch(fields):
    data = urllib.parse.urlencode(fields).encode()
    request = urllib.request.Request(
        ENDPOINT,
        data=data,
        headers={
            "User-Agent": UA,
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.9",
            "Content-Type": "application/x-www-form-urlencoded",
            "Origin": "https://html.duckduckgo.com",
            "Referer": "https://html.duckduckgo.com/",
            "Sec-Fetch-Dest": "document",
            "Sec-Fetch-Mode": "navigate",
            "Sec-Fetch-Site": "same-origin",
            "Sec-Fetch-User": "?1",
            "Upgrade-Insecure-Requests": "1",
        },
    )
    send, jar = opener()
    try:
        with send.open(request, timeout=TIMEOUT) as response:
            page = response.read().decode("utf-8", "replace")
        save_cookies(jar)
        return page
    except urllib.error.HTTPError as exc:
        if exc.code in (202, 403, 429):
            fail("blocked", f"DuckDuckGo returned HTTP {exc.code}")
        fail("http", f"HTTP {exc.code}")
    except urllib.error.URLError as exc:
        fail("network", str(exc.reason))
    except TimeoutError:
        fail("network", f"timed out after {TIMEOUT}s")


def parse(page):
    results = []
    for block in page.split(RESULT_SPLIT)[1:]:
        if "result--ad" in block:
            continue
        link = LINK_RE.search(block)
        if not link:
            continue
        url = unwrap(html.unescape(link.group(1)))
        title = clean(link.group(2))
        if not title or not url.startswith("http"):
            continue
        snippet = SNIPPET_RE.search(block)
        netloc = urllib.parse.urlparse(url).netloc
        results.append(
            {
                "title": title,
                "url": url,
                "snippet": clean(snippet.group(1)) if snippet else "",
                "display_url": netloc,
                # DDG serves a favicon per domain; derived rather than scraped
                # from the markup so it survives a layout change.
                "icon": ICON_ENDPOINT + netloc + ".ico" if netloc else "",
            }
        )
        if len(results) >= MAX_RESULTS:
            break
    return results


def extract_next(page, current_offset):
    """The forward nav form, verbatim. Pages past the first also carry a
    'previous' form, so take the one with the largest offset."""
    best = None
    best_offset = current_offset
    for form in FORM_RE.findall(page):
        fields = dict(INPUT_RE.findall(form))
        if "s" not in fields:
            continue
        try:
            offset = int(fields["s"])
        except ValueError:
            continue
        if offset > best_offset:
            best, best_offset = {k: html.unescape(v) for k, v in fields.items()}, offset
    return best


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "--next":
        if len(argv) < 2:
            fail("usage", "--next needs a JSON payload")
        try:
            fields = json.loads(argv[1])
        except ValueError:
            fail("usage", "--next payload is not valid JSON")
        if not isinstance(fields, dict) or "q" not in fields:
            fail("usage", "--next payload must be the form object")
        offset = int(fields.get("s") or 0)
    else:
        query = " ".join(argv).strip()
        if not query:
            fail("usage", "no query given")
        fields = {"q": query}
        offset = 0

    page = fetch(fields)
    results = parse(page)

    if not results:
        # Tell a real empty result set apart from a page that never had results.
        if "challenge" in page or "confirm this search was made by a human" in page:
            fail("blocked", "DuckDuckGo is showing an anti-bot challenge")
        if "no-results" in page or "No results." in page:
            emit({"ok": True, "results": [], "next": None})
        else:
            fail("blocked", "no results found in response")
    emit({"ok": True, "results": results, "next": extract_next(page, offset)})


if __name__ == "__main__":
    main()
