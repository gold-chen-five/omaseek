#!/usr/bin/env bash
# Hot reload for a checkout outside ~/.config/omarchy/plugins: Omarchy's inotify
# watcher doesn't follow symlinks. Not needed when developing in place. A rescan
# never rebuilds a keepLoaded component; use omarchy-restart-shell for that.
#
# Usage: ./bin/dev-watch   (Ctrl-C to stop)

set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

command -v inotifywait >/dev/null || { echo "need inotify-tools" >&2; exit 1; }

echo "watching $repo — saving a .qml or manifest.json reloads the plugin"
while inotifywait -q -r -e close_write,create,delete,move \
  --exclude '(\.git/|~$|\.swp$)' "$repo" >/dev/null; do
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  echo "reloaded $(date +%H:%M:%S)"
done
