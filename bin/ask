#!/usr/bin/env python3
"""Ask an AI coding agent from the panel, or hand it the conversation.

    ./bin/ask --agents                              installed agents, and the default
    ./bin/ask --models --json '{"agent":"codex"}'   model choices from the CLI or its cache
    ./bin/ask --json '{"question": "…"}'            one answer
    ./bin/ask --stream --json '{"question": "…"}'   the same answer, as it is written
    ./bin/ask --translate --json '{"text": "…", "target": "zh-TW"}'   a translation, and nothing else
    ./bin/ask --launch --json '{"prompt": "…"}'     open an editable draft in the agent
    ./bin/ask --login --json '{"agent": "…"}'       hand its sign-in or setup to a terminal

The payload can also come on stdin. Each turn runs the agent CLI's print mode
with the conversation in the prompt: no API keys, no SDK. Installed agents are
found the way Omarchy finds them (~/.local/bin, mise, the installer's --check),
not by PATH: Omarchy leaves a mise shim there for every agent, installed or not.

Output is always one JSON object:
    {"ok": true, "agents": [...], "default": "claude"}
    {"ok": true, "text": "…", "agent": "claude"}
    {"ok": true, "text": "…", "agent": "claude", "target": "zh-TW"}   (--translate)

--stream instead writes newline-delimited events, flushed as they arrive:
    {"event": "delta", "text": "…"}          repeatedly, display only
    {"event": "done", "ok": true, "text": "…", "agent": "claude", "model": "…"}
The done event carries the same body one answer would, failures and all, so an
agent with no streaming spelling simply emits that one line.
    {"ok": true, "launched": "claude", "launcher": "terminal"}
    {"ok": false, "error": "usage"|"agent"|"launcher"|"quota", "message": "…"}
    {"ok": false, "error": "auth"|"config", "login": true, "fix": "login"|"setup", "message": "…"}
"""

import os
import sys

# Bytecode goes to the cache, never beside the modules: Omarchy's watcher
# reloads a plugin on any file written inside its folder, so the __pycache__
# the first run creates tore the welcome page down on a fresh install.
sys.pycache_prefix = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "omaseek", "pycache")

# The modules live in backend/, beside bin/; realpath, so a symlinked install
# still finds them.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "backend"))

from omaseek.ask.main import main  # noqa: E402

if __name__ == "__main__":
    main()
