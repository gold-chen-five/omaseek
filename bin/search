#!/usr/bin/env python3
"""Web search -> JSON on stdout, through a SearXNG instance you run yourself.

Deliberately stdlib-only so the plugin has no venv and no dependencies.
Kept out of QML so fetching and shaping stay testable on their own:

    ./bin/search "python asyncio" | jq

Output is always a single JSON object:
    {"ok": true,  "results": [...], "next": {...}|null, "backend": "searxng"}
    {"ok": false, "error": "network"|"http"|"usage", "message": "...", "setup": true}

`--status` asks only whether the instance is up, for the settings page:
    {"ok": true, "running": true|false, "url": "http://localhost:8888"}

SearXNG is a metasearch engine: it queries the upstream engines on your behalf
and hands back merged results, so this panel talks only to a service you run.
That is the whole reason there is one backend and no scraping — nothing here
pretends to be a browser, and nothing here is subject to anyone else's terms.
See bin/searxng-up for getting one running.

`setup: true` marks the single failure a person can fix from the panel: the
instance is simply not running, so the panel offers to start it. Everything
else is reported as-is, because guessing would be worse than saying what broke.
"""

import hashlib
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

SEARXNG_DEFAULT_URL = "http://localhost:8888"
# Short on purpose: this sits behind a keypress, and a wedged instance should
# say so quickly rather than holding the panel. SearXNG's own upstream timeout
# (outgoing.request_timeout in settings.yml) is what bounds a normal search.
TIMEOUT = 8

CONFIG_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "jonas.search", "config.json",
)
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "jonas.search",
)

# A favicon CDN, not a search backend: it is sent a bare domain, never a query.
# ResultRow falls back to the domain's initial whenever it does not answer.
ICON_ENDPOINT = "https://external-content.duckduckgo.com/ip3/"

# Every page shows the same number of results. SearXNG pages vary in size —
# how many upstream engines answered in time decides it — so chunks are
# accumulated in a session buffer and sliced evenly from there.
PAGE_SIZE = 10          # overridden by results_per_page in the config
ENGINES = []            # overridden by searxng_engines in the config
PAGE_SIZE_CHOICES = (5, 10, 15, 20)
# Never burst: a single page turn may top the buffer up at most this many times.
MAX_FETCHES_PER_PAGE = 3


def emit(obj):
    json.dump(obj, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def fail(error, message, setup=False):
    payload = {"ok": False, "error": error, "message": message}
    if setup:
        payload["setup"] = True
    emit(payload)
    sys.exit(0)  # A handled failure is still a well-formed answer.


class SearchError(Exception):
    """The instance gave up. Raised rather than exited so callers can add context."""

    def __init__(self, kind, message, setup=False):
        super().__init__(message)
        self.kind = kind
        self.message = message
        self.setup = setup      # fixable by running bin/searxng-up


def read_config():
    """Settings written by the panel's settings page. Absent or broken config
    means defaults — a typo should cost one setting, not the search."""
    try:
        with open(CONFIG_PATH, encoding="utf-8") as handle:
            config = json.load(handle)
    except (OSError, ValueError):
        return {}
    return config if isinstance(config, dict) else {}


def configured_url(config):
    """Base URL of the instance. Hand-edited; the panel does not own it."""
    url = config.get("searxng_url")
    if isinstance(url, str) and url.strip():
        return url.strip().rstrip("/")
    return SEARXNG_DEFAULT_URL


def configured_engines(config):
    """Which engines to ask, by SearXNG name. Hand-edited, like the URL.

    SearXNG answers when every engine in the category has, so one slow engine
    sets the pace for all of them — and its defaults include ones that only
    ever fill an infobox this panel never shows. Naming the engines that
    actually return rows (measured here: 0.3s instead of 1.2s) is the single
    biggest speed lever, and it needs no edit to the container's settings.
    Empty or malformed means SearXNG's own choice.
    """
    engines = config.get("searxng_engines")
    if not isinstance(engines, list):
        return []
    return [e.strip() for e in engines if isinstance(e, str) and e.strip()]


def configured_page_size(config):
    size = config.get("results_per_page")
    return size if size in PAGE_SIZE_CHOICES else PAGE_SIZE


def fetch(base, query, pageno):
    """One page from SearXNG. Real pagination — no hidden forms to echo back."""
    params = {"q": query, "format": "json", "pageno": pageno}
    if ENGINES:
        params["engines"] = ",".join(ENGINES)
    url = base + "/search?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            payload = json.loads(response.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as exc:
        if exc.code in (403, 404):
            # By far the most common misconfiguration: SearXNG ships with
            # `formats: [html]`, so the JSON API 403s until it is turned on.
            # Running the setup script will not fix an existing settings.yml,
            # so this is deliberately not marked `setup`.
            raise SearchError(
                "http",
                f"SearXNG refused the JSON API at {base} — add 'json' under "
                "search.formats in settings.yml and restart it",
            )
        raise SearchError("http", f"SearXNG returned HTTP {exc.code}")
    except urllib.error.URLError as exc:
        raise SearchError(
            "network", f"SearXNG is not reachable at {base} ({exc.reason})", setup=True
        )
    except TimeoutError:
        raise SearchError("network", f"SearXNG timed out after {TIMEOUT}s")
    except ValueError:
        raise SearchError("http", "SearXNG returned an unreadable response")

    return parse(payload)


def instance_running(base):
    """Whether SearXNG answers at all. /healthz costs it nothing upstream."""
    try:
        with urllib.request.urlopen(base + "/healthz", timeout=2) as response:
            return 200 <= response.status < 300
    except urllib.error.HTTPError:
        return True         # it answered, however unhappily
    except (urllib.error.URLError, TimeoutError, ValueError):
        return False


def parse(payload):
    rows = []
    for item in payload.get("results") or []:
        url = (item.get("url") or "").strip()
        if not url.startswith("http"):
            continue
        netloc = urllib.parse.urlparse(url).netloc
        title = (item.get("title") or "").strip() or netloc
        snippet = " ".join((item.get("content") or "").split())
        rows.append({
            "title": title,
            "url": url,
            "snippet": snippet[:300],
            "display_url": netloc,
            "icon": ICON_ENDPOINT + netloc + ".ico" if netloc else "",
        })
    return rows


def session_path(query):
    digest = hashlib.sha256(query.encode("utf-8")).hexdigest()[:16]
    return os.path.join(CACHE_DIR, f"session-{digest}.json")


def load_session(query):
    try:
        with open(session_path(query), encoding="utf-8") as handle:
            session = json.load(handle)
    except (OSError, ValueError):
        return None
    return session if isinstance(session, dict) and session.get("rows") else None


def save_session(session):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(session_path(session["query"]), "w", encoding="utf-8") as handle:
            json.dump(session, handle)
    except OSError:
        pass  # paging will just refetch


def absorb(session, incoming):
    """Append new rows, dropping ones already buffered. Returns how many stuck.

    SearXNG merges and de-duplicates within a page, but the same document still
    turns up across page boundaries and under several canonical paths, so
    identity is domain+title as well as URL.
    """
    urls = {row["url"] for row in session["rows"]}
    documents = {(row["display_url"], row["title"].lower()) for row in session["rows"]}

    added = 0
    for row in incoming:
        document = (row["display_url"], row["title"].lower())
        if row["url"] in urls or document in documents:
            continue
        urls.add(row["url"])
        documents.add(document)
        session["rows"].append(row)
        added += 1
    return added


def start_session(query, base):
    session = {"query": query, "rows": [], "next": None, "backend": "searxng", "url": base}
    try:
        rows = fetch(base, query, 1)
    except SearchError as refused:
        fail(refused.kind, refused.message, setup=refused.setup)
    absorb(session, rows)
    session["next"] = {"pageno": 2} if rows else None
    return session


def grow_session(session, target):
    """Top the buffer up to `target` rows, within the burst limit."""
    fetches = 0
    while len(session["rows"]) < target and session["next"] and fetches < MAX_FETCHES_PER_PAGE:
        fetches += 1
        pageno = int(session["next"].get("pageno") or 2)
        try:
            rows = fetch(session["url"], session["query"], pageno)
        except SearchError:
            session["next"] = None       # stop offering more; keep what we have
            break
        added = absorb(session, rows)
        session["next"] = {"pageno": pageno + 1} if rows else None
        if added == 0:
            # Repeating itself means it has run out of useful results. Stop
            # rather than spending the remaining budget.
            session["next"] = None
            break
    return session


def emit_page(session, offset):
    # Fill the page, and not one row more. Asking for a lookahead row used to
    # cost a whole extra request whenever a SearXNG page came back exactly
    # PAGE_SIZE long — doubling the wait on a keypress to learn something the
    # panel recovers from anyway. `next` is now offered whenever SearXNG still
    # has a page to give; if that page turns out empty, the panel stays put and
    # stops offering more.
    grow_session(session, offset + PAGE_SIZE)
    save_session(session)

    rows = session["rows"]
    page = rows[offset:offset + PAGE_SIZE]
    has_more = len(rows) > offset + PAGE_SIZE or session["next"] is not None
    following = {"query": session["query"], "s": offset + PAGE_SIZE} if has_more else None

    empty = not page and offset == 0
    emit({
        "ok": True,
        "results": [] if empty else page,
        "next": None if empty else following,
        "backend": session["backend"],
    })


def main():
    global PAGE_SIZE, ENGINES
    config = read_config()
    base = configured_url(config)
    PAGE_SIZE = configured_page_size(config)
    ENGINES = configured_engines(config)

    argv = sys.argv[1:]

    if argv and argv[0] == "--status":
        emit({"ok": True, "running": instance_running(base), "url": base})
        return

    if argv and argv[0] == "--next":
        if len(argv) < 2:
            fail("usage", "--next needs a JSON payload")
        try:
            payload = json.loads(argv[1])
        except ValueError:
            fail("usage", "--next payload is not valid JSON")
        if not isinstance(payload, dict) or not payload.get("query"):
            fail("usage", "--next payload must name the query")

        query = str(payload["query"])
        offset = max(0, int(payload.get("s") or 0))

        # Paging back is free: the buffer already holds those rows.
        session = load_session(query) or start_session(query, base)
        emit_page(session, offset)
        return

    query = " ".join(argv).strip()
    if not query:
        fail("usage", "no query given")

    # Enter always searches afresh rather than serving a stale buffer.
    emit_page(start_session(query, base), 0)


if __name__ == "__main__":
    main()
