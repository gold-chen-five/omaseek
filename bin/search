#!/usr/bin/env python3
"""Web search -> JSON on stdout, through a SearXNG instance you run yourself.

    ./bin/search "python asyncio" | jq
    ./bin/search --next '<the next payload>'      the following page
    ./bin/search --status                          is the instance up?
    ./bin/search --test                            each engine alone: its rows and its time
    ./bin/search --time                            one real search: what a keypress waits for
    ./bin/search --version                         the running version, and whether it is the latest

Output is always one JSON object:
    {"ok": true,  "results": [...], "next": {...}|null, "backend": "searxng"}
    {"ok": false, "error": "network"|"http"|"usage", "message": "...", "setup": true}
    {"ok": true, "running": true|false, "url": "http://localhost:8888"}    (--status)
    {"ok": true, "ms": 1766, "engines": {"brave": {"rows": 20, "ms": 630}}, ...}  (--test)
    {"ok": true, "ms": 848, "rows": 28, "unresponsive": [...]}                    (--time)
    {"ok": true, "version": "2026.9.16+461f174b0", "latest": "2026.9.16-461f174b0", "current": true}
                                                                              (--version)

A failed page past the first carries `retry: true`: the buffer kept its place
and the same `--next` payload asks again, so the panel can offer a retry rather
than calling it the end.

`setup: true` marks the one failure the panel can fix: the instance is not
running. One backend by design: nothing here scrapes or calls a third-party API.
"""

import os
import sys

# The modules live in backend/, beside bin/; realpath, so a symlinked install
# still finds them.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "backend"))

from omaseek.search.main import main  # noqa: E402

if __name__ == "__main__":
    main()
