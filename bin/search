#!/usr/bin/env python3
"""Web search -> JSON on stdout. DuckDuckGo first, Exa as a fallback.

Deliberately stdlib-only so the plugin has no venv and no dependencies.
Kept out of QML so the fragile part (HTML parsing) is testable on its own:

    ./bin/search "python asyncio" | jq

Output is always a single JSON object:
    {"ok": true,  "results": [...], "next": {...}|null, "backend": "duckduckgo"|"exa"}
    {"ok": false, "error": "network"|"blocked"|"http"|"usage", "message": "..."}

DuckDuckGo is free and needs no key, but blocks under load. When it does and an
Exa key is configured, the query silently falls through to Exa instead of
failing. Configure with EXA_API_KEY, or:

    ~/.config/jonas.search/config.json   {"exa_api_key": "..."}

kept outside the plugin directory so a key is never committed.

The ok/false cases are distinguished on purpose: a blocked request and a
query with genuinely zero hits look identical to a naive parser, and the
panel must not tell the user "No results" when it was actually rebuffed.

Pagination: DuckDuckGo ignores a bare offset. The next page is only served
if the whole hidden form from the previous response is echoed back — vqd,
kl and nextParams included — so `next` carries that form verbatim and comes
back in as `--next '<json>'`.
"""

import hashlib
import http.cookiejar
import html
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

ENDPOINT = "https://html.duckduckgo.com/html/"
ICON_ENDPOINT = "https://external-content.duckduckgo.com/ip3/"

# Every query is a fresh process, so without this each search would arrive as a
# brand-new cookieless client — which is what DuckDuckGo's bot protection looks
# for. Persisting the jar makes a series of searches read as one session.
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "jonas.search",
)
COOKIE_PATH = os.path.join(CACHE_DIR, "cookies.txt")

CONFIG_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "jonas.search", "config.json",
)

EXA_ENDPOINT = "https://api.exa.ai/search"
# Exa has no offset parameter, so one call is paged locally from a cache.
# Three pages per request keeps a small free quota going much further.
EXA_PAGE_SIZE = 10
EXA_BATCH = 30
TIMEOUT = 12
MAX_RESULTS = 25

# A plain urllib UA gets a challenge page; a browser UA gets results.
UA = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
)

RESULT_SPLIT = '<div class="result results_links results_links_deep web-result'
LINK_RE = re.compile(
    r'<a[^>]*class="result__a"[^>]*href="([^"]+)"[^>]*>(.*?)</a>', re.S
)
SNIPPET_RE = re.compile(r'class="result__snippet"[^>]*>(.*?)</a>', re.S)
TAG_RE = re.compile(r"<[^>]+>")
FORM_RE = re.compile(r"<form[^>]*>.*?</form>", re.S)
INPUT_RE = re.compile(r'<input[^>]*name="([^"]+)"[^>]*value="([^"]*)"')


def emit(obj):
    json.dump(obj, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def fail(error, message):
    emit({"ok": False, "error": error, "message": message})
    sys.exit(0)  # A handled failure is still a well-formed answer.


class SearchError(Exception):
    """A backend gave up. Raised rather than exiting so main() can fall back."""

    def __init__(self, kind, message):
        super().__init__(message)
        self.kind = kind
        self.message = message


def clean(fragment):
    """HTML fragment -> plain text."""
    return html.unescape(TAG_RE.sub("", fragment)).strip()


def unwrap(href):
    """DDG wraps some links as //duckduckgo.com/l/?uddg=<encoded>."""
    if href.startswith("//"):
        href = "https:" + href
    try:
        query = urllib.parse.parse_qs(urllib.parse.urlparse(href).query)
    except ValueError:
        return href
    target = query.get("uddg")
    return urllib.parse.unquote(target[0]) if target else href


def opener():
    jar = http.cookiejar.MozillaCookieJar(COOKIE_PATH)
    try:
        jar.load(ignore_discard=True, ignore_expires=True)
    except (OSError, http.cookiejar.LoadError):
        pass  # first run, or an unreadable jar — start fresh
    return urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar)), jar


def save_cookies(jar):
    try:
        os.makedirs(os.path.dirname(COOKIE_PATH), exist_ok=True)
        jar.save(ignore_discard=True, ignore_expires=True)
    except OSError:
        pass  # a missing cache dir must not fail a search


def fetch(fields):
    data = urllib.parse.urlencode(fields).encode()
    request = urllib.request.Request(
        ENDPOINT,
        data=data,
        headers={
            "User-Agent": UA,
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.9",
            "Content-Type": "application/x-www-form-urlencoded",
            "Origin": "https://html.duckduckgo.com",
            "Referer": "https://html.duckduckgo.com/",
            "Sec-Fetch-Dest": "document",
            "Sec-Fetch-Mode": "navigate",
            "Sec-Fetch-Site": "same-origin",
            "Sec-Fetch-User": "?1",
            "Upgrade-Insecure-Requests": "1",
        },
    )
    send, jar = opener()
    try:
        with send.open(request, timeout=TIMEOUT) as response:
            page = response.read().decode("utf-8", "replace")
        save_cookies(jar)
        return page
    except urllib.error.HTTPError as exc:
        if exc.code in (202, 403, 429):
            raise SearchError("blocked", f"DuckDuckGo returned HTTP {exc.code}")
        raise SearchError("http", f"HTTP {exc.code}")
    except urllib.error.URLError as exc:
        raise SearchError("network", str(exc.reason))
    except TimeoutError:
        raise SearchError("network", f"timed out after {TIMEOUT}s")


def parse(page):
    results = []
    for block in page.split(RESULT_SPLIT)[1:]:
        if "result--ad" in block:
            continue
        link = LINK_RE.search(block)
        if not link:
            continue
        url = unwrap(html.unescape(link.group(1)))
        title = clean(link.group(2))
        if not title or not url.startswith("http"):
            continue
        snippet = SNIPPET_RE.search(block)
        netloc = urllib.parse.urlparse(url).netloc
        results.append(
            {
                "title": title,
                "url": url,
                "snippet": clean(snippet.group(1)) if snippet else "",
                "display_url": netloc,
                # DDG serves a favicon per domain; derived rather than scraped
                # from the markup so it survives a layout change.
                "icon": ICON_ENDPOINT + netloc + ".ico" if netloc else "",
            }
        )
        if len(results) >= MAX_RESULTS:
            break
    return results


def extract_next(page, current_offset):
    """The forward nav form, verbatim. Pages past the first also carry a
    'previous' form, so take the one with the largest offset."""
    best = None
    best_offset = current_offset
    for form in FORM_RE.findall(page):
        fields = dict(INPUT_RE.findall(form))
        if "s" not in fields:
            continue
        try:
            offset = int(fields["s"])
        except ValueError:
            continue
        if offset > best_offset:
            best, best_offset = {k: html.unescape(v) for k, v in fields.items()}, offset
    return best


def exa_key():
    """Env first so a key can be supplied for one run without touching config."""
    key = os.environ.get("EXA_API_KEY", "").strip()
    if key:
        return key
    try:
        with open(CONFIG_PATH, encoding="utf-8") as handle:
            return str(json.load(handle).get("exa_api_key", "")).strip()
    except (OSError, ValueError):
        return ""


def exa_cache_path(query):
    digest = hashlib.sha256(query.encode("utf-8")).hexdigest()[:16]
    return os.path.join(CACHE_DIR, f"exa-{digest}.json")


def exa_fetch(query, key):
    body = json.dumps({
        "query": query,
        "numResults": EXA_BATCH,
        "type": "auto",
        "contents": {"highlights": {"numSentences": 2}},
    }).encode()
    request = urllib.request.Request(
        EXA_ENDPOINT,
        data=body,
        headers={
            "x-api-key": key,
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            payload = json.load(response)
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            raise SearchError("auth", "Exa rejected the API key")
        raise SearchError("http", f"Exa returned HTTP {exc.code}")
    except urllib.error.URLError as exc:
        raise SearchError("network", str(exc.reason))
    except (TimeoutError, ValueError):
        raise SearchError("network", "Exa request failed")

    rows = []
    for item in payload.get("results", []):
        url = item.get("url") or ""
        if not url.startswith("http"):
            continue
        highlights = item.get("highlights") or []
        snippet = " ".join(highlights).strip() or (item.get("text") or "").strip()
        netloc = urllib.parse.urlparse(url).netloc
        rows.append({
            "title": (item.get("title") or netloc).strip(),
            "url": url,
            "snippet": " ".join(snippet.split())[:300],
            "display_url": netloc,
            "icon": ICON_ENDPOINT + netloc + ".ico" if netloc else "",
        })
    return rows


def search_exa(query, offset=0):
    """Exa has no offset parameter, so one batch is fetched and paged locally."""
    key = exa_key()
    if not key:
        raise SearchError("unconfigured", "no Exa API key")

    path = exa_cache_path(query)
    rows = None
    if offset > 0:
        try:
            with open(path, encoding="utf-8") as handle:
                rows = json.load(handle)
        except (OSError, ValueError):
            rows = None

    if rows is None:
        rows = exa_fetch(query, key)
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            with open(path, "w", encoding="utf-8") as handle:
                json.dump(rows, handle)
        except OSError:
            pass  # paging will just refetch

    page = rows[offset:offset + EXA_PAGE_SIZE]
    has_more = offset + EXA_PAGE_SIZE < len(rows)
    following = {"backend": "exa", "query": query, "s": offset + EXA_PAGE_SIZE} if has_more else None
    return page, following


def search_duckduckgo(fields, offset):
    page = fetch(fields)
    if "challenge" in page or "confirm this search was made by a human" in page:
        raise SearchError("blocked", "DuckDuckGo is showing an anti-bot challenge")

    results = parse(page)
    if not results:
        if "no-results" in page or "No results." in page:
            return [], None
        raise SearchError("blocked", "no results found in response")
    return results, extract_next(page, offset)


def main():
    argv = sys.argv[1:]

    if argv and argv[0] == "--next":
        if len(argv) < 2:
            fail("usage", "--next needs a JSON payload")
        try:
            payload = json.loads(argv[1])
        except ValueError:
            fail("usage", "--next payload is not valid JSON")
        if not isinstance(payload, dict) or "q" not in payload and "query" not in payload:
            fail("usage", "--next payload must be the form object")

        offset = int(payload.get("s") or 0)

        # Paging stays on whichever backend produced the page.
        if payload.get("backend") == "exa":
            try:
                results, following = search_exa(payload["query"], offset)
            except SearchError as error:
                fail(error.kind, error.message)
            emit({"ok": True, "results": results, "next": following, "backend": "exa"})
            return

        try:
            results, following = search_duckduckgo(payload, offset)
        except SearchError as error:
            fail(error.kind, error.message)
        emit({"ok": True, "results": results, "next": following, "backend": "duckduckgo"})
        return

    query = " ".join(argv).strip()
    if not query:
        fail("usage", "no query given")

    try:
        results, following = search_duckduckgo({"q": query}, 0)
        emit({"ok": True, "results": results, "next": following, "backend": "duckduckgo"})
        return
    except SearchError as error:
        primary = error

    # DuckDuckGo gave up. Fall through to Exa when a key is configured, so a
    # block degrades to a different backend rather than to a dead panel.
    try:
        results, following = search_exa(query, 0)
    except SearchError as fallback:
        if fallback.kind == "unconfigured":
            fail(primary.kind, primary.message)      # report the real failure
        fail(fallback.kind, f"{primary.message}; Exa fallback failed: {fallback.message}")

    emit({"ok": True, "results": results, "next": following, "backend": "exa"})


if __name__ == "__main__":
    main()
