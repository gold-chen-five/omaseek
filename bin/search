#!/usr/bin/env python3
"""Web search -> JSON on stdout. DuckDuckGo first, Exa as a fallback.

Deliberately stdlib-only so the plugin has no venv and no dependencies.
Kept out of QML so the fragile part (HTML parsing) is testable on its own:

    ./bin/search "python asyncio" | jq

Output is always a single JSON object:
    {"ok": true,  "results": [...], "next": {...}|null, "backend": "duckduckgo"|"exa"}
    {"ok": false, "error": "network"|"blocked"|"http"|"usage", "message": "..."}

DuckDuckGo is free and needs no key, but blocks under load. When it does the
query falls through to Exa's MCP endpoint, which also answers without a key.
Neither backend costs anything and neither needs configuring.

The ok/false cases are distinguished on purpose: a blocked request and a
query with genuinely zero hits look identical to a naive parser, and the
panel must not tell the user "No results" when it was actually rebuffed.

Pagination: DuckDuckGo ignores a bare offset. The next page is only served
if the whole hidden form from the previous response is echoed back — vqd,
kl and nextParams included — so `next` carries that form verbatim and comes
back in as `--next '<json>'`.
"""

import hashlib
import http.cookiejar
import html
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

ENDPOINT = "https://html.duckduckgo.com/html/"
ICON_ENDPOINT = "https://external-content.duckduckgo.com/ip3/"

# Every query is a fresh process, so without this each search would arrive as a
# brand-new cookieless client — which is what DuckDuckGo's bot protection looks
# for. Persisting the jar makes a series of searches read as one session.
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "jonas.search",
)
COOKIE_PATH = os.path.join(CACHE_DIR, "cookies.txt")

# Exa's MCP endpoint answers without an API key — the same endpoint opencode
# uses, and why its web search costs nothing. Exa's metered API at api.exa.ai
# is a separate product this deliberately does not touch.
EXA_ENDPOINT = "https://mcp.exa.ai/mcp"
# The endpoint has no offset parameter, so one call is paged locally from a
# cache: one request serves several pages.
EXA_BATCH = 30
TIMEOUT = 12
EXA_TIMEOUT = 25   # the MCP endpoint is slower than scraping a page
MAX_RESULTS = 30

# Every page shows the same number of results regardless of backend. Engines
# disagree wildly about page size — DuckDuckGo returns 10 for the first
# request and 15 for later offsets — so chunks are accumulated in a session
# buffer and sliced evenly. A 15-result fetch covers one and a half pages,
# which means fewer requests and less chance of being rate limited.
PAGE_SIZE = 10
# Never burst: a single page turn may top the buffer up at most this many times.
MAX_FETCHES_PER_PAGE = 3

# A plain urllib UA gets a challenge page; a browser UA gets results.
UA = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
)

RESULT_SPLIT = '<div class="result results_links results_links_deep web-result'
LINK_RE = re.compile(
    r'<a[^>]*class="result__a"[^>]*href="([^"]+)"[^>]*>(.*?)</a>', re.S
)
SNIPPET_RE = re.compile(r'class="result__snippet"[^>]*>(.*?)</a>', re.S)
TAG_RE = re.compile(r"<[^>]+>")
FORM_RE = re.compile(r"<form[^>]*>.*?</form>", re.S)
INPUT_RE = re.compile(r'<input[^>]*name="([^"]+)"[^>]*value="([^"]*)"')


def emit(obj):
    json.dump(obj, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def fail(error, message):
    emit({"ok": False, "error": error, "message": message})
    sys.exit(0)  # A handled failure is still a well-formed answer.


class SearchError(Exception):
    """A backend gave up. Raised rather than exiting so main() can fall back."""

    def __init__(self, kind, message):
        super().__init__(message)
        self.kind = kind
        self.message = message


def clean(fragment):
    """HTML fragment -> plain text."""
    return html.unescape(TAG_RE.sub("", fragment)).strip()


def unwrap(href):
    """DDG wraps some links as //duckduckgo.com/l/?uddg=<encoded>."""
    if href.startswith("//"):
        href = "https:" + href
    try:
        query = urllib.parse.parse_qs(urllib.parse.urlparse(href).query)
    except ValueError:
        return href
    target = query.get("uddg")
    return urllib.parse.unquote(target[0]) if target else href


def opener():
    jar = http.cookiejar.MozillaCookieJar(COOKIE_PATH)
    try:
        jar.load(ignore_discard=True, ignore_expires=True)
    except (OSError, http.cookiejar.LoadError):
        pass  # first run, or an unreadable jar — start fresh
    return urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar)), jar


def save_cookies(jar):
    try:
        os.makedirs(os.path.dirname(COOKIE_PATH), exist_ok=True)
        jar.save(ignore_discard=True, ignore_expires=True)
    except OSError:
        pass  # a missing cache dir must not fail a search


def fetch(fields):
    data = urllib.parse.urlencode(fields).encode()
    request = urllib.request.Request(
        ENDPOINT,
        data=data,
        headers={
            "User-Agent": UA,
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.9",
            "Content-Type": "application/x-www-form-urlencoded",
            "Origin": "https://html.duckduckgo.com",
            "Referer": "https://html.duckduckgo.com/",
            "Sec-Fetch-Dest": "document",
            "Sec-Fetch-Mode": "navigate",
            "Sec-Fetch-Site": "same-origin",
            "Sec-Fetch-User": "?1",
            "Upgrade-Insecure-Requests": "1",
        },
    )
    send, jar = opener()
    try:
        with send.open(request, timeout=TIMEOUT) as response:
            page = response.read().decode("utf-8", "replace")
        save_cookies(jar)
        return page
    except urllib.error.HTTPError as exc:
        if exc.code in (202, 403, 429):
            raise SearchError("blocked", f"DuckDuckGo returned HTTP {exc.code}")
        raise SearchError("http", f"HTTP {exc.code}")
    except urllib.error.URLError as exc:
        raise SearchError("network", str(exc.reason))
    except TimeoutError:
        raise SearchError("network", f"timed out after {TIMEOUT}s")


def parse(page):
    results = []
    for block in page.split(RESULT_SPLIT)[1:]:
        if "result--ad" in block:
            continue
        link = LINK_RE.search(block)
        if not link:
            continue
        url = unwrap(html.unescape(link.group(1)))
        title = clean(link.group(2))
        if not title or not url.startswith("http"):
            continue
        snippet = SNIPPET_RE.search(block)
        netloc = urllib.parse.urlparse(url).netloc
        results.append(
            {
                "title": title,
                "url": url,
                "snippet": clean(snippet.group(1)) if snippet else "",
                "display_url": netloc,
                # DDG serves a favicon per domain; derived rather than scraped
                # from the markup so it survives a layout change.
                "icon": ICON_ENDPOINT + netloc + ".ico" if netloc else "",
            }
        )
        if len(results) >= MAX_RESULTS:
            break
    return results


def extract_next(page, current_offset):
    """The forward nav form, verbatim. Pages past the first also carry a
    'previous' form, so take the one with the largest offset."""
    best = None
    best_offset = current_offset
    for form in FORM_RE.findall(page):
        fields = dict(INPUT_RE.findall(form))
        if "s" not in fields:
            continue
        try:
            offset = int(fields["s"])
        except ValueError:
            continue
        if offset > best_offset:
            best, best_offset = {k: html.unescape(v) for k, v in fields.items()}, offset
    return best


def exa_cache_path(query):
    digest = hashlib.sha256(query.encode("utf-8")).hexdigest()[:16]
    return os.path.join(CACHE_DIR, f"exa-{digest}.json")


# A record is a Title line immediately followed by a URL line; requiring both
# avoids mistaking a "Title:" inside highlight prose for a new result.
EXA_RECORD_RE = re.compile(r"^Title:\s*(?P<title>.*)\nURL:\s*(?P<url>\S+)", re.M)


def exa_payload_text(body):
    """The endpoint replies as JSON or as SSE; both wrap the same envelope."""

    def extract(chunk):
        try:
            data = json.loads(chunk)
        except ValueError:
            return None
        content = (data.get("result") or {}).get("content") or []
        for item in content:
            if item.get("text"):
                return item["text"]
        return None

    stripped = body.strip()
    if stripped.startswith("{"):
        direct = extract(stripped)
        if direct:
            return direct

    for line in body.split("\n"):
        if line.startswith("data: "):
            found = extract(line[6:])
            if found:
                return found
    return None


def parse_exa_text(text):
    """Exa returns prose records for an LLM, not JSON. Recover the fields.

    De-duplication happens here rather than downstream because Exa returns the
    same document under several canonical paths (/book/ and /stable/book/), and
    the batch is sliced into pages later — a duplicate pair straddling a page
    boundary would survive any per-page filtering.
    """
    rows = []
    seen_urls = set()
    seen_docs = set()
    matches = list(EXA_RECORD_RE.finditer(text))
    for index, match in enumerate(matches):
        url = match.group("url").strip()
        if not url.startswith("http"):
            continue

        body_end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
        body = text[match.end():body_end]
        snippet = body.split("Highlights:", 1)[1] if "Highlights:" in body else body
        snippet = " ".join(snippet.split()).strip(". ")

        netloc = urllib.parse.urlparse(url).netloc
        title = match.group("title").strip() or netloc
        document = (netloc, title.lower())
        if url in seen_urls or document in seen_docs:
            continue
        seen_urls.add(url)
        seen_docs.add(document)

        rows.append({
            "title": title,
            "url": url,
            "snippet": snippet[:300],
            "display_url": netloc,
            "icon": ICON_ENDPOINT + netloc + ".ico" if netloc else "",
        })
    return rows


def exa_fetch(query):
    body = json.dumps({
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
            "name": "web_search_exa",
            "arguments": {
                "query": query,
                "type": "auto",
                "numResults": EXA_BATCH,
                "livecrawl": "fallback",
            },
        },
    }).encode()

    request = urllib.request.Request(
        EXA_ENDPOINT,
        data=body,
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "User-Agent": UA,
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=EXA_TIMEOUT) as response:
            raw = response.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            # The keyless endpoint is undocumented; this is how it would look
            # if Exa ever put it behind authentication.
            raise SearchError("auth", "Exa now requires authentication")
        raise SearchError("http", f"Exa returned HTTP {exc.code}")
    except urllib.error.URLError as exc:
        raise SearchError("network", str(exc.reason))
    except TimeoutError:
        raise SearchError("network", "Exa request timed out")

    text = exa_payload_text(raw)
    if not text:
        raise SearchError("http", "Exa returned an unreadable response")
    return parse_exa_text(text)


def search_duckduckgo(fields, offset):
    page = fetch(fields)
    if "challenge" in page or "confirm this search was made by a human" in page:
        raise SearchError("blocked", "DuckDuckGo is showing an anti-bot challenge")

    results = parse(page)
    if not results:
        if "no-results" in page or "No results." in page:
            return [], None
        raise SearchError("blocked", "no results found in response")
    return results, extract_next(page, offset)


def session_path(query):
    digest = hashlib.sha256(query.encode("utf-8")).hexdigest()[:16]
    return os.path.join(CACHE_DIR, f"session-{digest}.json")


def load_session(query):
    try:
        with open(session_path(query), encoding="utf-8") as handle:
            session = json.load(handle)
    except (OSError, ValueError):
        return None
    return session if isinstance(session, dict) and session.get("rows") else None


def save_session(session):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(session_path(session["query"]), "w", encoding="utf-8") as handle:
            json.dump(session, handle)
    except OSError:
        pass  # paging will just refetch


def absorb(session, incoming):
    """Append new rows, dropping ones already buffered. Returns how many stuck.

    Engines repeat hits across page boundaries, and Exa returns the same
    document under several canonical paths, so identity is domain+title as
    well as URL.
    """
    urls = {row["url"] for row in session["rows"]}
    documents = {(row["display_url"], row["title"].lower()) for row in session["rows"]}

    added = 0
    for row in incoming:
        document = (row["display_url"], row["title"].lower())
        if row["url"] in urls or document in documents:
            continue
        urls.add(row["url"])
        documents.add(document)
        session["rows"].append(row)
        added += 1
    return added


def start_session(query):
    """A fresh query: DuckDuckGo first, Exa if it refuses."""
    session = {"query": query, "rows": [], "next": None, "backend": "duckduckgo"}
    try:
        rows, following = search_duckduckgo({"q": query}, 0)
        absorb(session, rows)
        session["next"] = following
        return session
    except SearchError as primary:
        pass

    session["backend"] = "exa"
    try:
        absorb(session, exa_fetch(query))
    except SearchError as fallback:
        fail(primary.kind, f"{primary.message}; Exa fallback also failed: {fallback.message}")
    session["next"] = None       # Exa has no offset; one batch is all of it
    return session


def grow_session(session, target):
    """Top the buffer up to `target` rows, within the burst limit."""
    fetches = 0
    while len(session["rows"]) < target and session["next"] and fetches < MAX_FETCHES_PER_PAGE:
        fetches += 1
        offset = int(session["next"].get("s") or 0)
        try:
            rows, following = search_duckduckgo(session["next"], offset)
        except SearchError:
            session["next"] = None       # stop offering more; keep what we have
            break
        added = absorb(session, rows)
        session["next"] = following
        if added == 0:
            # The engine is repeating itself — it has run out of useful
            # results. Stop rather than spending the remaining budget.
            session["next"] = None
            break
    return session


def emit_page(session, offset):
    # One row beyond the page, so "is there a next page" is answered by what is
    # actually buffered rather than by whether the engine still offers a link.
    # Without the lookahead the last page advertises a successor that turns out
    # to be empty.
    grow_session(session, offset + PAGE_SIZE + 1)
    save_session(session)

    rows = session["rows"]
    page = rows[offset:offset + PAGE_SIZE]
    has_more = len(rows) > offset + PAGE_SIZE
    following = {"query": session["query"], "s": offset + PAGE_SIZE} if has_more else None

    if not page and offset == 0:
        emit({"ok": True, "results": [], "next": None, "backend": session["backend"]})
        return
    emit({"ok": True, "results": page, "next": following, "backend": session["backend"]})


def main():
    argv = sys.argv[1:]

    if argv and argv[0] == "--next":
        if len(argv) < 2:
            fail("usage", "--next needs a JSON payload")
        try:
            payload = json.loads(argv[1])
        except ValueError:
            fail("usage", "--next payload is not valid JSON")
        if not isinstance(payload, dict) or not payload.get("query"):
            fail("usage", "--next payload must name the query")

        query = str(payload["query"])
        offset = max(0, int(payload.get("s") or 0))

        # Paging back is free: the buffer already holds those rows.
        session = load_session(query) or start_session(query)
        emit_page(session, offset)
        return

    query = " ".join(argv).strip()
    if not query:
        fail("usage", "no query given")

    # Enter always searches afresh rather than serving a stale buffer.
    emit_page(start_session(query), 0)


if __name__ == "__main__":
    main()
